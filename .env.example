# =============================================================================
# Gestão Advocacia — Variáveis de Ambiente
# Copie para .env e preencha os valores
# =============================================================================

# ----- SEGURANÇA (obrigatório em produção) -----
# Gere chaves fortes com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aqui
JWT_SECRET_KEY=sua-chave-jwt-aqui

# ----- BANCO DE DADOS -----
# SQLite para dev local:
DATABASE_URL=sqlite:///app.db
# PostgreSQL para produção (Render gera automaticamente):
# DATABASE_URL=postgresql://usuario:senha@host:5432/gestao_advocacia

# ----- UPLOAD DE ARQUIVOS -----
# Local (dev): deixe em branco — usa pasta uploads/ dentro do projeto
# Produção (Render Persistent Disk):
# UPLOAD_FOLDER=/mnt/data/uploads

# ----- CNJ / DataJud -----
CNJ_API_KEY=
CNJ_JOB_ENABLED=false
CNJ_JOB_INTERVAL_HOURS=12
CNJ_JOB_INTERVAL_MINUTES=0
CNJ_JOB_REQUEST_DELAY_SECONDS=5
CNJ_JOB_MAX_CASES_PER_RUN=10

# ----- APP -----
FLASK_ENV=development
LOG_LEVEL=INFO
APP_VERSION=1.1.3
SCHEDULER_TIMEZONE=America/Sao_Paulo

# ----- DJEN -----
DJEN_API_BASE_URL=https://comunicaapi.pje.jus.br
DJEN_JOB_ENABLED=false
DJEN_JOB_HOUR=4
DJEN_JOB_MINUTE=0
DJEN_LOOKBACK_DAYS=30
DJEN_ITENS_POR_PAGINA=100
DJEN_REQUEST_DELAY_SECONDS=1.5
DJEN_ENABLED_TENANTS=
DJEN_ROLLOUT_PERCENT=100
# Limite de publicações pendentes de triagem; se excedido, o sync automático é pausado
DJEN_SYNC_BACKLOG_LIMIT=50
