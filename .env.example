# =============================================================================
# Configurações do App Gestão Advocacia
# Copie este arquivo para .env e preencha os valores
# =============================================================================

# Chave secreta para Flask sessions (gere uma chave forte e única)
SECRET_KEY=sua-chave-secreta-aqui

# Chave secreta para JWT (gere uma chave forte e diferente da SECRET_KEY)
JWT_SECRET_KEY=sua-chave-jwt-aqui

# URL do banco de dados (PostgreSQL para produção, SQLite para dev)
# Exemplos:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gestao_advocacia
# DATABASE_URL=sqlite:///app.db
DATABASE_URL=sqlite:///app.db

# Chave da API do CNJ (DataJud) para consulta de processos
# Obtenha em: https://datajud-wiki.cnj.jus.br/
CNJ_API_KEY=

# Habilitar job automático de verificação CNJ (true/false)
CNJ_JOB_ENABLED=false

# Intervalo do job CNJ (em horas e minutos)
CNJ_JOB_INTERVAL_HOURS=12
CNJ_JOB_INTERVAL_MINUTES=0

# Delay entre requisições CNJ (em segundos) — para não sobrecarregar a API
CNJ_JOB_REQUEST_DELAY_SECONDS=5

# Máximo de casos verificados por execução do job
CNJ_JOB_MAX_CASES_PER_RUN=10

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Versão do app
APP_VERSION=1.0.0

# Fuso horário do scheduler
SCHEDULER_TIMEZONE=America/Sao_Paulo
