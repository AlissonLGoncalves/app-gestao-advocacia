# ============================================================================
# Backend - gestao_advocacia/.env.example
# Copie este arquivo para gestao_advocacia/.env e ajuste os valores.
# ============================================================================

# Seguranca da aplicacao (obrigatorio em producao)
SECRET_KEY=change-me-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-key

# Ambiente
FLASK_ENV=development
APP_VERSION=1.2.0
LOG_LEVEL=INFO

# Banco de dados
# Exemplo SQLite local
DATABASE_URL=sqlite:///app.db
# Exemplo PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gestao_advocacia

# Caminho de uploads (opcional)
# Se vazio, o backend usa a pasta local padrao.
UPLOAD_FOLDER=

# CORS e URLs publicas
# URL principal do frontend (usada em links de convite/reset)
FRONTEND_URL=http://localhost:5173
# Origens extras permitidas, separadas por virgula
CORS_ALLOWED_ORIGINS=

# Integracao CNJ/DataJud
CNJ_API_KEY=
CNJ_JOB_ENABLED=false
CNJ_JOB_INTERVAL_HOURS=12
CNJ_JOB_INTERVAL_MINUTES=0
CNJ_JOB_REQUEST_DELAY_SECONDS=5
CNJ_JOB_MAX_CASES_PER_RUN=10

# Scheduler
SCHEDULER_TIMEZONE=America/Sao_Paulo

# DJEN
DJEN_API_BASE_URL=https://comunicaapi.pje.jus.br
DJEN_JOB_ENABLED=false
DJEN_JOB_HOUR=4
DJEN_JOB_MINUTE=0
DJEN_LOOKBACK_DAYS=30
DJEN_ITENS_POR_PAGINA=100
# Cap de paginas por tentativa (ComunicaAPI aceita 5 ou 100 itens por pagina).
# 50 paginas x 100 itens = ate 5.000 publicacoes por OAB/processo/sigla.
DJEN_MAX_PAGINAS_POR_CONSULTA=50
DJEN_REQUEST_DELAY_SECONDS=1.5
# CSV de tenants habilitados (ex.: 1,2,3)
DJEN_ENABLED_TENANTS=
# Percentual de rollout (0-100)
DJEN_ROLLOUT_PERCENT=100

# Email (convites/recuperacao)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed de admin (opcional)
ADMIN_SEED_PASSWORD=

# OCR/IA (opcional)
GEMINI_API_KEY=

# Banco para testes (opcional, usado em testes automatizados)
TEST_DATABASE_URL=

# admin-fase0: Backoffice super-admin
# Lista CSV de IPs ou CIDRs autorizados a acessar /admin/v1/*.
# Se vazio/nao definido: allowlist DESATIVADO (qualquer IP com role=superadmin entra).
# Em producao: configurar para IPs do escritorio do dono da plataforma.
# Exemplos validos: "203.0.113.10,198.51.100.0/24"
ADMIN_IP_ALLOWLIST=
